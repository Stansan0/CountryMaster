<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FontRegistrer">


    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#A20808"
        android:src="@drawable/fondomundo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="297dp"
        android:layout_height="32dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="148dp"
        android:text="Nombre de tu nueva Nación:"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="297dp"
        android:layout_height="32dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="148dp"
        android:text="Nombre de tu nueva Nación:"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editTextNation2"
        android:layout_width="265dp"
        android:layout_height="30dp"
        android:background="@drawable/rounded_input"
        android:hint="nombre de nacion"
        android:visibility="visible"
        tools:ignore="MissingConstraints,TouchTargetSizeCheck"
        tools:layout_editor_absoluteX="74dp"
        tools:layout_editor_absoluteY="195dp"
        tools:visibility="visible" />

    <View
        android:id="@+id/whiteRectangle"
        android:layout_width="303dp"
        android:layout_height="614dp"
        android:background="@drawable/rounded_rectangle"
        app:layout_constraintBottom_toBottomOf="@id/imageView2"
        app:layout_constraintEnd_toEndOf="@id/imageView2"
        app:layout_constraintStart_toStartOf="@id/imageView2"
        app:layout_constraintTop_toTopOf="@id/imageView2"
        app:layout_constraintVertical_bias="0.495" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="77dp"
        android:layout_height="48dp"
        android:capitalize="characters"
        android:text="Paso 2"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="#370000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/whiteRectangle"
        app:layout_constraintEnd_toEndOf="@id/whiteRectangle"
        app:layout_constraintHorizontal_bias="0.066"
        app:layout_constraintStart_toStartOf="@id/whiteRectangle"
        app:layout_constraintTop_toTopOf="@id/whiteRectangle"
        app:layout_constraintVertical_bias="0.049" />

    <Button
        android:id="@+id/button2"
        android:layout_width="117dp"
        android:layout_height="33dp"
        android:background="@drawable/redondear_botones"
        android:text="Siguiente"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.77"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.124"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="297dp"
        android:layout_height="32dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="148dp"
        android:text="Nombre de tu nueva Nación:"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="296dp"
        android:layout_height="72dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="544dp"
        android:text="“Reyes o gobernantes no son los que llevan cetro, sino los que saben mandar.”"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="300dp"
        android:layout_height="24dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="624dp"
        android:text="Sócrates"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="297dp"
        android:layout_height="32dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="332dp"
        android:text="Divisa"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="297dp"
        android:layout_height="32dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="412dp"
        android:text="Animal"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="297dp"
        android:layout_height="32dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="244dp"
        android:text="Modelo Politico"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#3A0E0E"
        android:textDirection="firstStrongLtr"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="138dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteY="221dp"/>


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editTextNation"
        android:layout_width="265dp"
        android:layout_height="30dp"
        android:background="@drawable/rounded_input"
        android:hint="nombre de moneda"
        android:visibility="visible"
        tools:ignore="MissingConstraints,TouchTargetSizeCheck"
        tools:layout_editor_absoluteX="79dp"
        tools:layout_editor_absoluteY="364dp"
        tools:visibility="visible" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editTextNation3"
        android:layout_width="265dp"
        android:layout_height="30dp"
        android:background="@drawable/rounded_input"
        android:hint="Escriba un animal"
        android:visibility="visible"
        tools:ignore="MissingConstraints,TouchTargetSizeCheck"
        tools:layout_editor_absoluteX="74dp"
        tools:layout_editor_absoluteY="452dp"
        tools:visibility="visible" />

    <Spinner
        android:id="@+id/spinnerModeloPolitico"
        android:layout_width="268dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_input"
        app:layout_constraintStart_toStartOf="@id/textView6"
        app:layout_constraintTop_toBottomOf="@id/textView6"
        tools:ignore="MissingConstraints,TouchTargetSizeCheck" />
</androidx.constraintlayout.widget.ConstraintLayout>